body {
    font-family: Arial;
    background-color: #eeeeee;
    text-align: center;
    margin: 0;
}

header, footer {
    background-color: #0b3d91;
    color: white;
    padding: 20px;
}

main {
    padding: 20px;
}

img {
    width: 90%;
    max-width: 500px;
    border-radius: 10px;
}

a {
    display: block;
    background-color: #0b3d91;
    color: white;
    text-decoration: none;
    padding: 15px;
    margin: 10px auto;
    max-width: 300px;
    border-radius: 5px;
}

section {
    margin-bottom: 30px;
}

@media (max-width: 600px) {
    img {
        width: 100%;
    }
}
